{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(docker compose -f docker/compose.yaml ps:*)",
      "Bash(docker compose -f docker/compose.yaml logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git config user.name)",
      "Bash(git config user.email)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(date:*)",
      "Bash(ls:*)",
      "Skill(review-pr)",
      "Skill(writing-conventions)",
      "Skill(github-actions-workflows)",
      "Skill(review-dependency-bump)",
      "Skill(review-skill-update)",
      "Edit(.tmp/**)"
    ],
    "deny": [
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(corepack:*)",
      "Bash(tsc:*)",
      "Bash(biome:*)",
      "Bash(astro:*)",
      "Bash(vitest:*)"
    ]
  }
}
